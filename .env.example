# Copy to .env and edit. Nothing here is required: with an empty environment
# the control plane runs in memory and compose uses the defaults below.
#
#   cp .env.example .env
#
# Both compose and the Makefile read .env, so `docker compose up -d` and
# `make run` pick these up. Make parses the file literally: write values
# unquoted, with no trailing comments on a value line.

# ---------------------------------------------------------------------------
# Control plane (cmd/cerberus). Every one of these has a flag equivalent, and
# the flag wins: --addr, --policies, --token, --review-timeout.
# ---------------------------------------------------------------------------

# Address the HTTP API listens on.
CERBERUS_ADDR=:8080

# Directory of policy files, loaded at startup. A policy that does not parse,
# or that names a check nobody registered, is a startup failure rather than a
# surprise on live traffic.
CERBERUS_POLICY_DIR=policies

# Shared bearer token required on every /v1 route. Empty disables auth, which
# is fine on a laptop and nowhere else. There is no per-tenant auth yet: any
# caller holding this token can read every agent's traffic and decide any
# review.
CERBERUS_TOKEN=

# How long a quarantined or held event waits for a reviewer before the item is
# marked expired. The policy's action stands either way, so this is about when
# the queue item stops counting as waiting work, not about releasing the event.
CERBERUS_REVIEW_TIMEOUT=24h

# Stamped on every workflow and used to gate recovery: an executor only
# recovers workflows it can run. Set it per build (a commit SHA works) so two
# deployments with different check code never claim each other's in-flight
# evaluations.
CERBERUS_APP_VERSION=cerberus-dev

# ---------------------------------------------------------------------------
# Infrastructure. Leave either one empty to run without it: no DATABASE_URL
# means an in-memory store and anchora's memory store, no NATS_URL means the
# in-process broker. Both lose everything on restart, which is why they are
# for demos and tests.
# ---------------------------------------------------------------------------

# Postgres holds cerberus's tables and anchora's checkpoints, so this is the
# whole dependency list. Keep the credentials in step with POSTGRES_* below.
DATABASE_URL=postgres://cerberus:cerberus@localhost:5432/cerberus?sslmode=disable

# NATS with JetStream enabled. Ingest returns once the event is durable here.
NATS_URL=nats://localhost:4222

# ---------------------------------------------------------------------------
# CLI (cmd/guardrails). Also reads CERBERUS_TOKEN and DATABASE_URL above.
# ---------------------------------------------------------------------------

# Control plane the review and demo commands talk to.
CERBERUS_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Groundedness judge. Entirely optional: without a key the check falls back to
# its lexical baseline rather than going silent, and its verdicts are reported
# and never enforced either way.
# ---------------------------------------------------------------------------

# Enables the LLM judge. Every verdict it returns is a metered call, which is
# why the check samples traffic and sits behind an overlap pre-filter.
ANTHROPIC_API_KEY=

# Judge model. Defaults to claude-opus-5-5.
CERBERUS_JUDGE_MODEL=claude-opus-5-5

# Per-million-token prices used to attribute cost to each verdict, in USD.
# Change these when you change the model, or the spend panel will lie.
CERBERUS_JUDGE_PRICE_IN=4.00
CERBERUS_JUDGE_PRICE_OUT=20.00

# ---------------------------------------------------------------------------
# docker compose only.
# ---------------------------------------------------------------------------

POSTGRES_USER=cerberus
POSTGRES_PASSWORD=cerberus
POSTGRES_DB=cerberus

# Grafana is reachable at http://localhost:3000 and allows anonymous viewing,
# so this password is only for editing.
GRAFANA_ADMIN_PASSWORD=admin
